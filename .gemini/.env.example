# GEMINI Settings
# GEMINI_API_KEY 通常由系統環境變數提供；若需要指定，可在本機 .gemini/.env 定義。

# File MCP allow roots (semicolon-separated on Windows).
FILE_MCP_ROOTS="YOUR_PROJECT_ROOT;Other allow roots..."

# SDLC generated artifacts
# Relative root is resolved from the skills-hub repository root.
# You may use an absolute path to store generated artifacts outside this repository.
SDLC_ARTIFACT_ROOT="docs/_generated"
SDLC_SA_SPEC_SUBDIR="sa-specs"
SDLC_DB_SUBDIR="db"
SDLC_WORKFLOW_SUBDIR="workflows"
SDLC_DEV_DOC_SUBDIR="dev-docs"
SDLC_REQUIREMENTS_SUBDIR="requirements"
SDLC_FLOWCHART_SUBDIR="flowchart"

# Redmine MCP
REDMINE_URL="YOUR_REDMINE_URL"
REDMINE_API_KEY="YOUR_REDMINE_API_KEY"

# Git MCP
# 若未設定，會 fallback 到 FILE_MCP_ROOTS 或 process.cwd().
GIT_MCP_ROOTS="YOUR_PROJECT_ROOT;Other git roots..."

# DB Metadata MCP
# SDLC database access is configured-alias-only.
# Target project web.config / appsettings connection strings must never be used to establish DB connections.
# Use a dedicated read-only account. Do not commit real credentials.
DB_METADATA_DEFAULT_CONNECTION="dbexample-dev"
DB_METADATA_CONNECTIONS='{
  "dbexample-dev": {
    "type": "mssql",
    "displayName": "DB Example DEV",
    "description": "Development MSSQL database for DB metadata lookup.",
    "environment": "dev",
    "system": "dbexample",
    "database": "DBExample_DEV",
    "tags": ["dbexample", "dev", "development", "mssql"],
    "connectionString": "Server=YOUR_DEV_SERVER;Database=DBExample_DEV;User Id=YOUR_READONLY_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=true;"
  },
  "dbexample-uat": {
    "type": "mssql",
    "displayName": "DB Example UAT",
    "description": "UAT MSSQL database for DB metadata lookup.",
    "environment": "uat",
    "system": "dbexample",
    "database": "DBExample_UAT",
    "tags": ["dbexample", "uat", "testing", "mssql"],
    "connectionString": "Server=YOUR_UAT_SERVER;Database=DBExample_UAT;User Id=YOUR_READONLY_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=true;"
  }
}'

# Test Runner MCP
# Commands must be a JSON object and each value must be a string array.
TEST_RUNNER_ROOTS="YOUR_PROJECT_ROOT;Other test roots..."
TEST_RUNNER_COMMANDS='{"npm-test":["npm","test"],"dotnet-test":["dotnet","test"]}'

# Static Analysis MCP
STATIC_ANALYSIS_ROOTS="YOUR_PROJECT_ROOT;Other analysis roots..."
STATIC_ANALYSIS_COMMANDS='{"npm-lint":["npm","run","lint"],"npm-build":["npm","run","build"],"dotnet-build":["dotnet","build"]}'

# Secret Scan MCP
SECRET_SCAN_ROOTS="YOUR_PROJECT_ROOT;Other scan roots..."
